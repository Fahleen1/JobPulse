# Supabase (required for SSR health page + later feed reads)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — never expose in the browser or commit real values
# Required for Module 3 ingestion writes (seed / persist / ingest)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional alias for CLI scripts (defaults to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

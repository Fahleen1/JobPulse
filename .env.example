# Supabase (required for SSR health page + feed reads)
# Use project origin only — do NOT append /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — never expose in the browser or commit real values
# Required for Module 3 ingestion writes (seed / persist / ingest)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional alias for CLI scripts (defaults to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Optional Adzuna (Tier A). If unset, Adzuna source is not seeded / soft-skipped.
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=

{
  "name": "jobpulse",
  "version": "0.1.0",
  "private": true,
  "description": "JobPulse — real-time remote job aggregator for IT professionals",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "proof": "tsx src/proof.ts",
    "proof:fixture": "tsx src/proof.ts --fixture",
    "ingest:seed": "tsx src/ingest/seed-cli.ts",
    "ingest:persist": "tsx src/ingest/persist-cli.ts",
    "ingest:persist:fixture": "tsx src/ingest/persist-cli.ts --fixture",
    "ingest": "tsx src/ingest/ingest-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ingest.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  }
}
